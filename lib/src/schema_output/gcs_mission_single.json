{
    "packet_name": "gcs_mission_single",
    "version": "1.0.0",
    "description": "sending a single waypoint from GCS to flight controller",
    "headers": {
        "header1": "0xca",
        "header2": "0xfe",
        "senderId": "0x02",
        "receiverId": "0x01",
        "messageId": "0xA1",
        "dataLength": "0x1B"
    },
    "data": [
        {
            "tag": "waypoint_number",
            "type": "uint16"
        },
        {
            "tag": "waypoint_latitude",
            "type": "double"
        },
        {
            "tag": "waypoint_longitude",
            "type": "double"
        },
        {
            "tag": "waypoint_altitude",
            "type": "float"
        },
        {
            "tag": "waypoint_speed",
            "type": "uint16"
        },
        {
            "tag": "waypoint_mode",
            "type": "uint8"
        },
        {
            "tag": "waypoint_param",
            "type": "uint16"
        }
    ],
    "checksum": "CRC16"
}
